{
  "$comment": "Хуки проекта (взято из UNIFIED/templates/hooks/project-settings.json; добавлен PreCompact). Лежат в репозитории, а не в настройках пользователя: они про этот проект, версионируются вместе с ним и переносятся вместе с ним. Скрипты — scripts/hooks/; параметры установки скрипты берут из /etc/harness/install.conf. Каждый хук закрывает грабли, которые уже случались. defaultMode=bypassPermissions (В-6): владелец видит только Telegram, интерактивные подтверждения оболочки некому нажимать; опасное отсекает guard_bash. session_state.sh на source=compact печатает короткий блок «после компакта» (В-1: stdout PreCompact модель не видит), на resume — обычный отчёт состояния (В-6).",
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/hooks/session_state.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/scripts/hooks/guard_bash.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/scripts/check-file-names.py --hook"
          },
          {
            "type": "command",
            "command": "python3 $CLAUDE_PROJECT_DIR/scripts/check-kirillica-v-imenah.py --hook"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/hooks/stop_reminder.sh",
            "timeout": 20
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/scripts/hooks/pre_compact.sh",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "bash $CLAUDE_PROJECT_DIR/scripts/hooks/skill_log.sh"
          }
        ]
      }
    ]
  }
}