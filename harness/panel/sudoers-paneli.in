# ШАБЛОН прав службы панели. Рабочий файл собирает шаг установки, подставляя
# @PROJECT_DIR@ из паспорта: путь проекта у каждой установки свой.
#
# Три узких действия, у каждого своя проверка белого списка ВНУТРИ скрипта
# (находка C5 ревью спеки панели 11.09.2026). Панель не получает права
# «делать что угодно от root» — она получает право звать три названных
# скрипта, которые сами судят, что им разрешено записать.
#
# Ставится только через `visudo -c -f`: битый файл в /etc/sudoers.d ломает
# sudo на машине целиком, и чинить его будет некому — владелец терминала не
# видит.
harness-panel ALL=(root) NOPASSWD: /usr/bin/python3 @PROJECT_DIR@/scripts/zapisat-klyuch.py *
harness-panel ALL=(root) NOPASSWD: /usr/bin/python3 @PROJECT_DIR@/scripts/zapisat-shag.py *
harness-panel ALL=(root) NOPASSWD: /usr/bin/python3 @PROJECT_DIR@/scripts/zapisat-pamyat.py *

# Право АГЕНТА (под ним работает диспетчер) ровно одно: запустить скрипт
# вывода панели наружу. Ревью кода 13.09.2026 показало, почему список из
# девяти «узких» строк узким не был: `install -m 644 /tmp/* …` принимает в
# аргументах любые опции (man 5 sudoers: в АРГУМЕНТАХ «*» берёт и слэши),
# `certbot … *` пускает `--pre-hook` с произвольной командой, а право
# запускать от root файл из каталога, куда агент пишет, равно NOPASSWD: ALL.
# Поэтому скрипт лежит в /usr/local/lib/harness (root:root, агент туда не
# пишет), а единственный аргумент — имя хоста — проверяет он сам.
@AGENT_USER@ ALL=(root) NOPASSWD: /usr/local/lib/harness/panel-naruzhu-root.sh *
